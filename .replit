modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "S-Movie Download Page"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "S-MOVIE App"

[[workflows.workflow]]
name = "API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[[workflows.workflow]]
name = "S-Movie Download Page"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=21381 BASE_PATH=/smovie-download/ pnpm --filter @workspace/smovie-download run dev"
waitForPort = 21381

[[workflows.workflow]]
name = "S-MOVIE App"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=23135 pnpm --filter @workspace/s-movie run dev"
waitForPort = 23135

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
EXPO_PUBLIC_FIREBASE_API_KEY = "AIzaSyBLjgLERkJysAS-J1Ya4OOlX8t0u049hjs"
EXPO_PUBLIC_API_URL = "https://dac17775-d574-4473-b458-342664acd72e-00-3innc9zb1vb5.sisko.replit.dev/api"
